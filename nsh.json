{
  "name": "Brewman",
  "id": "app.brewman.desktop",
  "version": "0.1.1",
  "build": 1,
  "theme": "theme.json",
  "capabilities": {
    "process": {
      "execute": [
        "brew",
        "/opt/homebrew/bin/brew",
        "/usr/local/bin/brew"
      ]
    },
    "application": true,
    "statusBar": true,
    "openUrl": {
      "schemes": [
        "https"
      ]
    }
  },
  "window": {
    "title": "Brewman",
    "defaultSize": {
      "width": 1120,
      "height": 720
    },
    "minSize": {
      "width": 800,
      "height": 520
    },
    "titleBar": {
      "style": "hidden",
      "height": 42
    }
  },
  "appearance": "dark",
  "icon": "assets/icon.png",
  "dependencies": {
    "nsh-icon": "^0.2.2",
    "nsh-icon-lucide": "^0.2.2"
  }
}
